# Copy to .env and fill in. Everything here is bundled into the website and is PUBLIC.

# Supabase: Project Settings > API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# PayPal: developer.paypal.com > Apps & Credentials > Sandbox > your app > Client ID
# (The Secret goes into Supabase secrets, never into this file.)
VITE_PAYPAL_CLIENT_ID=your-sandbox-client-id
